{
  // Static site on Cloudflare Workers (assets only, no worker script), like games.nexumia.de.
  "name": "nexumia-homepage",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "nexumia.de", "custom_domain": true },
    { "pattern": "www.nexumia.de", "custom_domain": true }
  ],
  "previews": {}
}
